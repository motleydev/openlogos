    {
      "from_scheme": "eng",
      "from": "Joel.1.1-Joel.1.20",
      "to_scheme": "org",
      "to": "Joel.1.1-Joel.1.20",
      "kind": "equal",
      "source": "Joel 1 has 20 verses in both numberings."
    },
    {
      "from_scheme": "eng",
      "from": "Joel.2.1-Joel.2.27",
      "to_scheme": "org",
      "to": "Joel.2.1-Joel.2.27",
      "kind": "equal",
      "source": "Joel 2:1-27 agree; the Hebrew chapter ends at verse 27."
    },
    {
      "from_scheme": "eng",
      "from": "Joel.2.28-Joel.2.32",
      "to_scheme": "org",
      "to": "Joel.3.1-Joel.3.5",
      "kind": "equal",
      "source": "English Joel 2:28-32 (the outpouring of the Spirit) is Hebrew Joel 3:1-5."
    },
    {
      "from_scheme": "eng",
      "from": "Joel.3.1-Joel.3.21",
      "to_scheme": "org",
      "to": "Joel.4.1-Joel.4.21",
      "kind": "equal",
      "source": "English Joel 3 is Hebrew Joel 4 (21 verses in both)."
    },
    {
      "from_scheme": "eng",
      "from": "Mal.3.1-Mal.3.18",
      "to_scheme": "org",
      "to": "Mal.3.1-Mal.3.18",
      "kind": "equal",
      "source": "Malachi 3:1-18 agree."
    },
    {
      "from_scheme": "eng",
      "from": "Mal.4.1-Mal.4.6",
      "to_scheme": "org",
      "to": "Mal.3.19-Mal.3.24",
      "kind": "equal",
      "source": "Hebrew Malachi has three chapters: English 4:1-6 is Hebrew 3:19-24."
    }
