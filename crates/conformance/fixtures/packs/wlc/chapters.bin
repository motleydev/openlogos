{"format":"openlogos-text-pack-chapter","resource_id":"wlc","chapter_key":"Gen.1","verses":[{"segment_id":"Gen.1.1","number":1,"last_number":1,"label":"1","text":"בְּרֵאשִׁ֖ית בָּרָ֣א אֱלֹהִ֑ים אֵ֥ת הַשָּׁמַ֖יִם וְאֵ֥ת הָאָֽרֶץ׃","paragraph_start":true,"poetry":false,"superscription":false,"placeholder":false,"tokens":[{"id":"wlc:01001001001","start":0,"end":12},{"id":"wlc:01001001002","start":13,"end":20},{"id":"wlc:01001001003","start":21,"end":30},{"id":"wlc:01001001004","start":31,"end":35},{"id":"wlc:01001001005","start":36,"end":48},{"id":"wlc:01001001006","start":49,"end":55},{"id":"wlc:01001001007","start":56,"end":64}]},{"segment_id":"Gen.1.2","number":2,"last_number":2,"label":"2","text":"וְהָאָ֗רֶץ הָיְתָ֥ה תֹ֨הוּ֙ וָבֹ֔הוּ וְחֹ֖שֶׁךְ עַל־פְּנֵ֣י תְה֑וֹם וְר֣וּחַ אֱלֹהִ֔ים מְרַחֶ֖פֶת עַל־פְּנֵ֥י הַמָּֽיִם׃","paragraph_start":false,"poetry":false,"superscription":false,"placeholder":false,"tokens":[{"id":"wlc:01001002001","start":0,"end":10},{"id":"wlc:01001002002","start":11,"end":19},{"id":"wlc:01001002003","start":20,"end":27},{"id":"wlc:01001002004","start":28,"end":36},{"id":"wlc:01001002005","start":37,"end":47},{"id":"wlc:01001002006","start":48,"end":51},{"id":"wlc:01001002007","start":52,"end":59},{"id":"wlc:01001002008","start":60,"end":67},{"id":"wlc:01001002009","start":68,"end":76},{"id":"wlc:01001002010","start":77,"end":86},{"id":"wlc:01001002011","start":87,"end":97},{"id":"wlc:01001002012","start":98,"end":101},{"id":"wlc:01001002013","start":102,"end":109},{"id":"wlc:01001002014","start":110,"end":119}]}]}
