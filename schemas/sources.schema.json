{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:sources",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "pinned_artifact": {
      "description": "1.0 forced null (nothing was pinned). 1.1 (B003) allows an object naming the rights record that holds the exact artifact hashes; a 1.0 document still validates.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rights_records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^rights/[A-Za-z0-9._-]+\\.json$"
              }
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{40}$"
            },
            "fetched_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "storage": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rights_records",
            "commit",
            "fetched_on",
            "storage"
          ]
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "checked_on": {
      "type": "string"
    },
    "notice": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "secondary_url": {
                "type": "string"
              },
              "finding": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "pinned_artifact": {
                "$ref": "#/$defs/pinned_artifact"
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "secondary_url",
              "finding",
              "status",
              "pinned_artifact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "secondary_url": {
                "type": "null"
              },
              "finding": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "pinned_artifact": {
                "$ref": "#/$defs/pinned_artifact"
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "secondary_url",
              "finding",
              "status",
              "pinned_artifact"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "checked_on",
    "notice",
    "sources"
  ]
}
