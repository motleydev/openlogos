{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:text-pack",
  "type": "object",
  "additionalProperties": false,
  "description": "The manifest of a text pack (B078, specs/23 §4): one edition, chapter-chunked. Each chapter's chunk is a file (chapters/<Book>/<C>.json) or a byte range of one bundle (chapters.bin), checked against its SHA-256 before use. B071's importer writes this format for the installed BSB, SBLGNT and WLC; crates/text reading::pack reads it.",
  "properties": {
    "format": {
      "const": "openlogos-text-pack"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "content_revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP 47 tag."
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "scheme": {
      "type": "string",
      "minLength": 1,
      "description": "Versification scheme of every reference in the pack (eng, org)."
    },
    "book_order": {
      "enum": [
        "protestant",
        "tanakh_bhs"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean",
      "description": "Whether every chapter has every verse of the scheme; false for an excerpt."
    },
    "books": {
      "type": "array",
      "description": "Books in reading order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "book": {
            "type": "string",
            "pattern": "^[1-3]?[A-Z][A-Za-z]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chapter": {
                  "type": "integer",
                  "minimum": 1
                },
                "first_verse": {
                  "type": "integer",
                  "minimum": 0
                },
                "last_verse": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  },
                  "description": "Relative to the pack directory; no . or .. segment."
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "length": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "chapter",
                "first_verse",
                "last_verse",
                "path",
                "length",
                "sha256"
              ]
            }
          }
        },
        "required": [
          "book",
          "title",
          "chapters"
        ]
      }
    }
  },
  "required": [
    "format",
    "format_version",
    "resource_id",
    "content_revision",
    "title",
    "name",
    "language",
    "direction",
    "scheme",
    "license",
    "source",
    "complete",
    "books"
  ]
}
