{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:session",
  "type": "object",
  "additionalProperties": false,
  "description": "The session record of specs/22 §2 (B070): which workspaces are open, in order, which is active and which tool the floating tool palette has selected. Each workspace is its own record (schemas/workspace-2.schema.json), so one can be shared or exported alone.",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "workspace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
      }
    },
    "active_workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "enum": [
        "select",
        "highlight",
        "pen",
        "highlighter_pen",
        "eraser",
        "collect"
      ]
    },
    "next_serial": {
      "type": "integer",
      "minimum": 0
    },
    "reading": {
      "description": "Text size step from the platform default, line spacing and theme (B070 follow-up for B072); text_size_step indexes the seven token sizes 15/17/19/21/24/28/32 pt of design/tokens/shell.json with 0 = 19; absent means the defaults (0, 1.5, system).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_size_step": {
          "type": "integer",
          "minimum": -2,
          "maximum": 4
        },
        "line_spacing": {
          "type": "number",
          "enum": [
            1.35,
            1.5,
            1.7
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark",
            "sepia"
          ]
        }
      },
      "required": [
        "text_size_step",
        "line_spacing",
        "theme"
      ]
    },
    "ink": {
      "description": "The tool palette's brush width and its two swatch wells, kept with the tool (specs/22 §4); absent means the defaults (4, #F5D90A, #4CC38A, the token highlight colours).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "enum": [
            1,
            2,
            4,
            6,
            8,
            12,
            16
          ]
        },
        "swatch": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "alternate_swatch": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "width",
        "swatch",
        "alternate_swatch"
      ]
    }
  },
  "required": [
    "schema_version",
    "fixture_only",
    "workspace_ids",
    "active_workspace_id",
    "tool",
    "next_serial"
  ]
}
