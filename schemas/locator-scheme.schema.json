{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:locator-scheme",
  "title": "Locator scheme catalog",
  "description": "The device catalog's `locator_scheme` entries (specs/19-search-and-retrieval.md, Cross-resource links, item 1; specs/03-data-model.md, LocatorScheme): one citable coordinate system per entry for a non-Bible work, hierarchical (book.chapter.section), question/answer, or the page milestones of a named print edition. Each work has exactly one canonical scheme; an edge whose locator carries no `scheme:` prefix is in it. Entries are the serialized form of openlogos_retrieval::LocatorScheme; the grammar that reads citations into a scheme is openlogos_core::locator and is versioned by grammar_version.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schemes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scheme"
      }
    }
  },
  "required": [
    "schema_version",
    "schemes"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "work": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "boolean"
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "hierarchical",
                "question_answer",
                "page"
              ]
            },
            "print_edition": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "page"
                  }
                }
              },
              "then": {
                "required": [
                  "print_edition"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "print_edition"
                  ]
                }
              }
            }
          ]
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "grammar_version": {
          "type": "string",
          "pattern": "^b[0-9]{3}-[0-9]+$"
        }
      },
      "required": [
        "id",
        "work",
        "title",
        "canonical",
        "kind",
        "levels",
        "version",
        "grammar_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "properties": {
                  "kind": {
                    "const": "page"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "canonical": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
