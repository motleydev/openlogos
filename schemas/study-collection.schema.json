{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:study-collection",
  "title": "Study collection",
  "description": "The serialized form of openlogos_collections::StudyCollection (specs/03-data-model.md, Collection and source-selection contracts; specs/15): stable ids, ordered memberships, groups, tags and revisions. Source-bearing items (source_reference, source_excerpt) keep edition, artifact hash, content revision, locator, original anchor and a rights snapshot; a source_excerpt stores text only when the snapshot allows quotation. observation and research_excerpt are distinct kinds that never become source quotations; machine output carries a generated label. Schema 1.0.",
  "$defs": {
    "rights_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rights_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "quotation": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "unknown"
          ]
        },
        "license_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "quotation"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "work_locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "page_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "page_label": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "page_index"
              ]
            }
          ]
        }
      },
      "required": [],
      "anyOf": [
        {
          "properties": {
            "reference": {
              "type": "string"
            }
          },
          "required": [
            "reference"
          ]
        },
        {
          "properties": {
            "work_locator": {
              "type": "string"
            }
          },
          "required": [
            "work_locator"
          ]
        },
        {
          "properties": {
            "pdf": {
              "type": "object"
            }
          },
          "required": [
            "pdf"
          ]
        }
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "translator_or_editor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "content_revision": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "anchor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:open-bible-blueprint:anchor"
            }
          ]
        },
        "rights": {
          "$ref": "#/$defs/rights_snapshot"
        },
        "display": {
          "$ref": "#/$defs/display"
        }
      },
      "required": [
        "edition_id",
        "content_revision",
        "locator",
        "rights"
      ]
    },
    "collection_item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "added_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "kind": {
              "const": "source_reference"
            },
            "source": {
              "$ref": "#/$defs/source_provenance"
            }
          },
          "required": [
            "id",
            "revision",
            "added_at",
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "added_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "kind": {
              "const": "source_excerpt"
            },
            "source": {
              "$ref": "#/$defs/source_provenance"
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "added_at",
            "kind",
            "source"
          ],
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "rights": {
                    "properties": {
                      "quotation": {
                        "enum": [
                          "deny",
                          "unknown"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "added_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "kind": {
              "const": "observation"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision",
            "added_at",
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "added_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "kind": {
              "const": "research_excerpt"
            },
            "generated_label": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            },
            "thread_id": {
              "type": "string",
              "minLength": 1
            },
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "$ref": "#/$defs/source_provenance"
                  }
                },
                "required": [
                  "evidence_id",
                  "source"
                ]
              }
            }
          },
          "required": [
            "id",
            "revision",
            "added_at",
            "kind",
            "generated_label",
            "text",
            "thread_id",
            "message_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "group_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                }
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "added_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "kind": {
              "const": "margin_attachment"
            },
            "attachment_id": {
              "type": "string",
              "minLength": 1
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "added_at",
            "kind",
            "attachment_id",
            "media_type",
            "sha256"
          ]
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection_item"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "owner_id",
    "revision",
    "created_at",
    "updated_at",
    "items"
  ]
}
