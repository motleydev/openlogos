{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:backlog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "proposed_issues_not_executable_jobs"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]{3}$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5"
            ]
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spec_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "initial_status": {
            "type": "string",
            "enum": [
              "blocked",
              "ready_for_scaffold"
            ]
          },
          "human_gate": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "phase",
          "owner_role",
          "title",
          "depends_on",
          "acceptance",
          "spec_paths",
          "initial_status",
          "human_gate"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "tasks"
  ]
}
