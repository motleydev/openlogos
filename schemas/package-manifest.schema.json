{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:package-manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "fixture_only": {
      "type": "boolean"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "minimum_reader_version": {
      "type": "string",
      "minLength": 1
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "media_type"
        ]
      }
    },
    "rights_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attribution_path": {
      "type": "string",
      "minLength": 1
    },
    "previous_manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "Ed25519"
              ]
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "value_base64": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "value_base64"
          ]
        }
      ]
    },
    "core_api_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "edition_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edition_id": {
            "type": "string",
            "minLength": 1
          },
          "content_revision": {
            "type": "string",
            "minLength": 1
          },
          "tokenization_hash": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        },
        "required": [
          "edition_id",
          "content_revision",
          "tokenization_hash"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "fixture_only",
    "package_id",
    "revision",
    "minimum_reader_version",
    "editions",
    "artifacts",
    "rights_record_ids",
    "attribution_path",
    "previous_manifest_sha256",
    "signature"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "fixture_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "signature": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "core_api_version",
          "edition_revisions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "core_api_version"
              ]
            },
            {
              "required": [
                "edition_revisions"
              ]
            }
          ]
        }
      }
    }
  ],
  "description": "A corpus pack's provenance manifest. Schema 1.1 adds core_api_version (the openlogos_core::API_VERSION the pack's tables were written against) and edition_revisions (content revision and tokenization hash per edition, which alignments and lineage tables are checked against). A 1.0 manifest has neither; a 1.1 reader fills them as unknown (docs/adr/0003-identity-and-schema-versioning.md)."
}
