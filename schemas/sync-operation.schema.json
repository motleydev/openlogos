{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:sync-operation",
  "title": "Sync operation batch",
  "description": "A batch of signed operation headers and their sealed payloads, as one device or a hub hands them to another (openlogos_sync::log::Operation and envelope::SealedPayload; docs/adr/0004-vault-identity-and-sync.md; specs/03-data-model.md 'Notes and synchronization'). Each operation carries a globally unique id (SHA-256 of its signing input), the writing device, that device's sequence number, its causal parents, the key epoch, the change and the hash of the sealed payload, under the device's Ed25519 signature. Nothing in a batch is plaintext user content and nothing is a key: a batch may be stored by a hub that cannot read it. Schema 1.0.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "vault_id": {
      "$ref": "#/$defs/vault_id"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "payloads": {
      "type": "object",
      "description": "Sealed payloads by the id of the operation that commits to them.",
      "additionalProperties": false,
      "patternProperties": {
        "^op-[0-9a-f]{64}$": {
          "$ref": "#/$defs/sealed_payload"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "vault_id",
    "operations",
    "payloads"
  ],
  "$defs": {
    "vault_id": {
      "type": "string",
      "pattern": "^vault-[0-9a-f]{32}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^dev-[0-9a-f]{32}$"
    },
    "op_id": {
      "type": "string",
      "pattern": "^op-[0-9a-f]{64}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
    },
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex192": {
      "type": "string",
      "pattern": "^[0-9a-f]{48}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "op_id": {
          "$ref": "#/$defs/op_id"
        },
        "vault_id": {
          "$ref": "#/$defs/vault_id"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "device_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/op_id"
          }
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "payload_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "required": [
        "schema_version",
        "op_id",
        "vault_id",
        "device_id",
        "device_sequence",
        "parents",
        "key_epoch",
        "change",
        "payload_hash",
        "signature"
      ]
    },
    "change": {
      "description": "Opaque ids only; names, bodies and anchors travel in the sealed payload.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "note_body"
            },
            "note_id": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "required": [
            "kind",
            "note_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "highlight_add",
                "highlight_remove"
              ]
            },
            "highlight_id": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "required": [
            "kind",
            "highlight_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "tag_add",
                "tag_remove"
              ]
            },
            "entity_id": {
              "$ref": "#/$defs/stable_id"
            },
            "tag_id": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "required": [
            "kind",
            "entity_id",
            "tag_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tombstone"
            },
            "entity_id": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "required": [
            "kind",
            "entity_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tombstone_ack"
            },
            "entity_id": {
              "$ref": "#/$defs/stable_id"
            },
            "tombstone": {
              "$ref": "#/$defs/op_id"
            }
          },
          "required": [
            "kind",
            "entity_id",
            "tombstone"
          ]
        }
      ]
    },
    "sealed_payload": {
      "type": "object",
      "description": "XChaCha20-Poly1305 ciphertext under the vault key of key_epoch; its SHA-256 (nonce then ciphertext) is the operation's payload_hash.",
      "additionalProperties": false,
      "properties": {
        "key_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "$ref": "#/$defs/hex192"
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^([0-9a-f]{2}){16,}$"
        }
      },
      "required": [
        "key_epoch",
        "nonce",
        "ciphertext"
      ]
    }
  }
}
