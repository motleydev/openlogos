{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:claim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_only": {
      "type": "boolean"
    },
    "relation": {
      "type": "string",
      "enum": [
        "edition_revises",
        "edition_uses_source",
        "witness_supports_reading",
        "span_aligns_with",
        "occurrence_has_analysis",
        "occurrence_uses_sense",
        "explicitly_cites",
        "quotes",
        "alludes_to",
        "shares_theme",
        "lexeme_etymologically_related"
      ]
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact_sha256",
          "locator",
          "source_record_id"
        ]
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "import",
            "deterministic",
            "model",
            "human"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "run_id",
        "prompt_sha256"
      ]
    },
    "review_state": {
      "type": "string",
      "enum": [
        "proposed",
        "source_attested",
        "reviewed",
        "published",
        "rejected",
        "disputed",
        "superseded",
        "retracted"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "review_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "fixture_only",
    "relation",
    "subject_ids",
    "object_ids",
    "scope",
    "evidence",
    "producer",
    "review_state",
    "confidence",
    "review_event_ids",
    "supersedes",
    "rationale"
  ]
}
