{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-bible-blueprint:workspace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "panes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "reading",
              "notes",
              "research",
              "lexicon"
            ]
          },
          "content_id": {
            "type": "string",
            "minLength": 1
          },
          "content_revision": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "width_fraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "kind",
          "content_id",
          "content_revision",
          "reference",
          "link_group",
          "pinned",
          "width_fraction"
        ]
      }
    },
    "notes_dock_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_pane_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "fixture_only",
    "id",
    "title",
    "panes",
    "notes_dock_id",
    "active_pane_id"
  ]
}
