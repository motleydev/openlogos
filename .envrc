# shellcheck shell=bash
# Loads the Nix dev shell (Rust toolchain, just, lefthook, ...) whenever you cd into the repo.
# One-time: install Nix (flakes enabled) and direnv, ideally with nix-direnv for cached
# shells, then run `direnv allow`. The default shell is `.#core`; for another one put
# `use flake .#web` (or .#apple, .#android, .#pipeline, .#ops) in .envrc.local instead.
watch_file flake.nix flake.lock
use flake

# Personal, untracked overrides, e.g. `export ANDROID_HOME=$HOME/Library/Android/sdk`.
source_env_if_exists .envrc.local
